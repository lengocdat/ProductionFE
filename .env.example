# Runtime-only server configuration. Never expose backend or merchant secrets to NEXT_PUBLIC_*.
API_INTERNAL_URL=http://127.0.0.1:8080
APP_PUBLIC_URL=http://localhost:3000
# Đạo Tràng Online (WebSocket goes straight to the Go API; Next cannot proxy it).
# Leave unset in production when Nginx routes /v1/room/ws to Go on the same origin.
# NEXT_PUBLIC_ROOM_WS_URL=ws://localhost:8080/v1/room/ws
