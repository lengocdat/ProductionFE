<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <!-- Green circle background -->
  <circle cx="32" cy="32" r="30" fill="#22c55e"/>
  <!-- Shuttlecock body (white) -->
  <ellipse cx="32" cy="38" rx="5" ry="7" fill="white"/>
  <!-- Shuttlecock feathers -->
  <path d="M 27 30 Q 32 10 37 30" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M 24 32 Q 32 14 40 32" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <path d="M 29 28 Q 32 16 35 28" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.85"/>
  <!-- Racket handle hint -->
  <line x1="32" y1="45" x2="32" y2="52" stroke="white" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
</svg>
